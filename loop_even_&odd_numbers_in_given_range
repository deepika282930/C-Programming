#include<stdio.h>
int main()
{
    int start,end,i;
    printf("Enter starting and ending numbers: ");
    scanf("%d%d", &start, &end);
    for(i=start;i<=end;i++)
    {
        if(i%2 == 0)
         {   printf("%d is Even\n", i); }
        else
          {  printf("%d is Odd\n", i); }
    }
    return 0;
}

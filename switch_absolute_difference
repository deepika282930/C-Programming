#include<stdio.h>
int main()
{
    int a,b,choice;
    printf("Enter two numbers: ");
    scanf("%d%d", &a, &b);
    printf("1.Find absolute difference");
    printf("Enter choice: ");
    scanf("%d", &choice);
    switch(choice)
    {
        case 1:
            if(a>b)
                printf("Difference = %d",a-b);
            else
                printf("Difference = %d",b-a);
            break;
        default:
            printf("Invalid choice");
    }
    return 0;
}

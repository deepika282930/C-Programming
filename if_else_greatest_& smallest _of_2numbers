#include<stdio.h>
int main()
{
    int a,b;
    printf("Enter two numbers: ");
    scanf("%d%d", &a, &b);
    if(a>b)
    {
        printf("Greatest = %d",a);
        printf("\nSmallest = %d",b);
    }
    else
    {
        printf("Greatest = %d",b);
        printf("\nSmallest = %d",a);
    }
    return 0;
}
